{
  "name": "claude-code-worktrees",
  "version": "0.2.1",
  "description": "Manage git worktrees as running environments — provisioned, ported, served.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "ccwt": "./bin/ccwt.mjs",
    "claude-code-worktrees": "./bin/ccwt.mjs"
  },
  "files": [
    "bin",
    ".output",
    "plugin",
    ".claude-plugin"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node bin/ccwt.mjs --dev",
    "build": "nuxt build && npm run build:plugin",
    "build:plugin": "node scripts/build-plugin.mjs",
    "test": "node --test",
    "prepare": "nuxt prepare",
    "prepack": "npm run build",
    "preview": "node .output/server/index.mjs",
    "typecheck": "nuxt typecheck && npm run typecheck:plugin",
    "typecheck:plugin": "tsc6 --noEmit -p plugin/tsconfig.json",
    "start": "node bin/ccwt.mjs"
  },
  "dependencies": {
    "kysely": "^0.29.5",
    "lucide-vue-next": "^1.0.0",
    "nuxt": "^4.5.0",
    "vue": "^3.5.22",
    "vue-router": "^5.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^26.2.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "tailwindcss": "^4.1.14",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vue-tsc": "^3.3.10"
  }
}
